---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  console.log('🔍 생성된 slug 목록:', posts.map((p) => p.id));
  console.log('🔍 글 개수:', posts.length);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title}</title>
    <meta name="description" content={post.data.description} />
  </head>
  <body>
    <main style="max-width: 720px; margin: 40px auto; padding: 0 20px; font-family: sans-serif; line-height: 1.7;">
      <h1>{post.data.title}</h1>
      <p style="color: #888; font-size: 14px;">
        {post.data.pubDate.toLocaleDateString('ko-KR')}
      </p>
      <hr />
      <article>
        <Content />
      </article>
    </main>
  </body>
</html>