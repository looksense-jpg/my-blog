---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title}</title>
    <meta name="description" content={post.data.description} />
    <style is:global>
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Malgun Gothic', sans-serif;
        line-height: 1.8;
        color: #333;
        background: #fafafa;
        margin: 0;
      }
      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px 20px 60px;
        background: #fff;
        min-height: 100vh;
      }
      header.site-header {
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 20px;
        margin-bottom: 40px;
      }
      header.site-header h1 { font-size: 26px; margin: 0; }
      header.site-header a { color: #111; text-decoration: none; }
      h1 { font-size: 28px; margin: 32px 0 16px; }
      h2 { font-size: 22px; margin: 40px 0 16px; border-left: 4px solid #4f46e5; padding-left: 12px; }
      p { margin: 0 0 18px; }
      a { color: #4f46e5; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .qa-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 30px;
      }
      .question, .answer {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 20px;
        background: #fff;
      }
      .question {
        border-left: 4px solid #4f46e5;
        background: #f9f9ff;
      }
      .answer {
        border-left: 4px solid #ccc;
        margin-left: 40px;
      }
      .answer.accepted-answer {
        border-left: 4px solid #22c55e;
        background: #f0fdf4;
      }
      .author {
        font-weight: bold;
        font-size: 14px;
        color: #4f46e5;
        margin-bottom: 8px;
      }
      .answer .author { color: #333; }
      .content {
        font-size: 15px;
        line-height: 1.7;
      }
      .meta {
        font-size: 12px;
        color: #999;
        margin-top: 10px;
        text-align: right;
      }
      .cta-button {
        display: inline-block;
        background: #f97316;
        color: #fff !important;
        padding: 10px 18px;
        border-radius: 6px;
        font-weight: bold;
        margin-top: 10px;
        text-decoration: none !important;
        font-size: 14px;
      }
      .cta-button:hover { background: #ea580c; }
      .post-header { border-bottom: 1px solid #f0f0f0; padding-bottom: 20px; margin-bottom: 32px; }
      .post-meta { color: #999; font-size: 14px; }
      footer.site-footer { margin-top: 60px; padding-top: 24px; border-top: 1px solid #f0f0f0; color: #999; font-size: 13px; text-align: center; }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <h1><a href="/my-blog/">재택근무 장비 블로그</a></h1>
      </header>

      <article>
        <div class="post-header">
          <h1>{post.data.title}</h1>
          <div class="post-meta">{post.data.pubDate.toLocaleDateString('ko-KR')}</div>
        </div>
        <Content />
      </article>

      <footer class="site-footer">
        © 2026 재택근무 장비 블로그
      </footer>
    </div>
  </body>
</html>