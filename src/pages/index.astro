---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>재택근무 장비 블로그</title>
    <meta name="description" content="재택근무에 필요한 장비를 솔직하게 리뷰합니다." />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <h1><a href="/my-blog/">재택근무 장비 블로그</a></h1>
        <p>재택근무자를 위한 장비 리뷰와 추천</p>
      </header>

      <main>
        <h2>최신 글</h2>
        <ul class="post-list">
          {sortedPosts.map((post) => (
            <li>
              <a href={`/my-blog/blog/${post.id}/`}>{post.data.title}</a>
              <div class="date">{post.data.pubDate.toLocaleDateString('ko-KR')}</div>
              <p class="desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      </main>

      <footer class="site-footer">
        © 2026 재택근무 장비 블로그
      </footer>
    </div>
  </body>
</html>